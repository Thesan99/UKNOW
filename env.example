# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Optional: HuggingFace read token to lift anonymous rate limits on shared IPs.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Optional: where large data lives. Defaults to ./data next to the repo.
# UKNOW_DATA=/scratch/uknow_data

# Optional: contact string embedded in the Wikimedia User-Agent (Commons
# requires a real contact). Defaults to the project URL.
# UKNOW_CONTACT=https://github.com/yourname/uknow

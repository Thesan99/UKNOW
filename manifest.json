{
  "manifest_version": 3,
  "name": "UKNOW",
  "version": "1.0",
  "description": "Right-click any image to check if it's AI-generated.",
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon128.png"
  },
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-real-detector@example.com",
      "strict_min_version": "121.0"
    }
  }
}